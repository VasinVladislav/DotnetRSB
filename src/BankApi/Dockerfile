# ==========================================
# ЭТАП 1: Окружение для сборки (Тяжелый SDK)
# ==========================================
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build-env
WORKDIR /app

# 1. Копируем файл настроек проекта и восстанавливаем зависимости (пакеты NuGet)
COPY *.csproj ./
RUN dotnet restore

# 2. Копируем абсолютно весь исходный код проекта и файлы данных
COPY . ./

# 3. Компилируем и публикуем проект в режиме Release в папку /app/out
RUN dotnet publish -c Release -o out

# ==========================================
# ЭТАП 2: Финальное легкое окружение (Runtime)
# ==========================================
FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app

# 4. Копируем скомпилированный чистый бинарник из первого этапа
COPY --from=build-env /app/out .

# 5. Открываем порт, на котором будет слушать наше веб-приложение
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

# 6. Команда для запуска нашего сервера при старте контейнера
ENTRYPOINT ["dotnet", "BankApi.dll"]